{
  "$id": "https://github.com/whitehair-failure/SenrenBanka-fonts/schemas/family.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cssVariable": {
      "pattern": "^--[a-z0-9-]+$",
      "type": "string"
    },
    "fallbacks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "familyName": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "license": {
      "additionalProperties": false,
      "properties": {
        "approvedForRedistribution": {
          "const": true,
          "type": "boolean"
        },
        "evidenceUrl": {
          "format": "uri",
          "type": "string"
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 200,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "sha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "reservedFontNames": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "reviewedAt": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "reviewedBy": {
          "minLength": 1,
          "type": "string"
        },
        "rfn": {
          "additionalProperties": false,
          "properties": {
            "basis": {
              "minLength": 1,
              "type": "string"
            },
            "permissionEvidenceUrl": {
              "format": "uri",
              "type": "string"
            },
            "permissionText": {
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "enum": [
                "not-applicable",
                "unmodified-distribution",
                "permission-granted",
                "renamed"
              ],
              "type": "string"
            }
          },
          "required": [
            "status",
            "basis"
          ],
          "type": "object"
        },
        "spdx": {
          "enum": [
            "OFL-1.1",
            "Apache-2.0",
            "CC0-1.0"
          ],
          "type": "string"
        }
      },
      "required": [
        "spdx",
        "approvedForRedistribution",
        "reviewedAt",
        "reviewedBy",
        "evidenceUrl",
        "files",
        "reservedFontNames",
        "rfn"
      ],
      "type": "object"
    },
    "output": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "fixed",
              "type": "string"
            },
            "variants": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "display": {
                    "enum": [
                      "auto",
                      "block",
                      "swap",
                      "fallback",
                      "optional"
                    ],
                    "type": "string"
                  },
                  "features": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "file": {
                    "maxLength": 200,
                    "type": "string"
                  },
                  "sourceFile": {
                    "maxLength": 200,
                    "type": "string"
                  },
                  "stretch": {
                    "pattern": "^(?:\\d{1,3}(?:\\.\\d+)?%|\\d{1,3}(?:\\.\\d+)?% \\d{1,3}(?:\\.\\d+)?%)$",
                    "type": "string"
                  },
                  "style": {
                    "enum": [
                      "normal",
                      "italic",
                      "oblique"
                    ],
                    "type": "string"
                  },
                  "unicodeRange": {
                    "items": {
                      "pattern": "^U\\+[0-9A-F?]{1,6}(?:-[0-9A-F]{1,6})?$",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "variationSettings": {
                    "additionalProperties": {
                      "type": "number"
                    },
                    "propertyNames": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "weight": {
                    "pattern": "^(?:100|200|300|400|500|600|700|800|900)(?: (?:100|200|300|400|500|600|700|800|900))?$",
                    "type": "string"
                  }
                },
                "required": [
                  "sourceFile",
                  "file",
                  "weight",
                  "style",
                  "display"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "type",
            "variants"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "chunkSize": {
              "maximum": 262144,
              "minimum": 256,
              "type": "integer"
            },
            "display": {
              "enum": [
                "auto",
                "block",
                "swap",
                "fallback",
                "optional"
              ],
              "type": "string"
            },
            "fontFeature": {
              "const": true,
              "type": "boolean"
            },
            "languageAreas": {
              "const": true,
              "type": "boolean"
            },
            "rename": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "to"
              ],
              "type": "object"
            },
            "sourceFile": {
              "maxLength": 200,
              "type": "string"
            },
            "style": {
              "enum": [
                "normal",
                "italic",
                "oblique"
              ],
              "type": "string"
            },
            "subsetStrategy": {
              "const": "subset-font",
              "type": "string"
            },
            "type": {
              "const": "core-cjk",
              "type": "string"
            },
            "weight": {
              "pattern": "^(?:100|200|300|400|500|600|700|800|900)(?: (?:100|200|300|400|500|600|700|800|900))?$",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sourceFile",
            "weight",
            "style",
            "display",
            "chunkSize",
            "languageAreas",
            "fontFeature"
          ],
          "type": "object"
        }
      ]
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "minLength": 1,
          "type": "string"
        },
        "processing": {
          "minLength": 1,
          "type": "string"
        },
        "retrievedAt": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        }
      },
      "required": [
        "retrievedAt",
        "processing",
        "notes"
      ],
      "type": "object"
    },
    "role": {
      "enum": [
        "fixed",
        "core-cjk"
      ],
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "scripts": {
      "items": {
        "enum": [
          "cjk",
          "hangul",
          "han-traditional"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "bootstrapKey": {
                "maxLength": 240,
                "pattern": "^(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\\\)(?!\\/).+$",
                "type": "string"
              },
              "download": {
                "additionalProperties": false,
                "properties": {
                  "archiveMember": {
                    "maxLength": 240,
                    "pattern": "^(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\\\)(?!\\/).+$",
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "url": {
                    "format": "uri",
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "sha256"
                ],
                "type": "object"
              },
              "fileName": {
                "maxLength": 200,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "size": {
                "exclusiveMinimum": 0,
                "maximum": 536870912,
                "type": "integer"
              }
            },
            "required": [
              "fileName",
              "size",
              "sha256",
              "bootstrapKey"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "project": {
          "minLength": 1,
          "type": "string"
        },
        "retrievedAt": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "project",
        "version",
        "url",
        "retrievedAt",
        "files"
      ],
      "type": "object"
    },
    "sourceFamilyName": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "familyName",
    "sourceFamilyName",
    "role",
    "version",
    "source",
    "license",
    "output",
    "cssVariable",
    "fallbacks",
    "provenance"
  ],
  "title": "SenrenBanka font family descriptor v1",
  "type": "object"
}
