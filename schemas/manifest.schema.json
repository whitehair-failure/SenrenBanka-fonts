{
  "$id": "https://github.com/whitehair-failure/SenrenBanka-fonts/schemas/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "buildTools": {
          "additionalProperties": false,
          "properties": {
            "cnFontSplit": {
              "minLength": 1,
              "type": "string"
            },
            "fontkitten": {
              "minLength": 1,
              "type": "string"
            },
            "schema": {
              "const": 1,
              "type": "number"
            }
          },
          "required": [
            "cnFontSplit",
            "fontkitten",
            "schema"
          ],
          "type": "object"
        },
        "css": {
          "const": "font.css",
          "type": "string"
        },
        "cssVariable": {
          "pattern": "^--[a-z0-9-]+$",
          "type": "string"
        },
        "fallbacks": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "familyName": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "kind": {
          "const": "family",
          "type": "string"
        },
        "license": {
          "additionalProperties": false,
          "properties": {
            "approvedForRedistribution": {
              "const": true,
              "type": "boolean"
            },
            "evidenceUrl": {
              "format": "uri",
              "type": "string"
            },
            "files": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "allOf": [
                      {
                        "pattern": "^(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\\\)(?!\\/).+$"
                      },
                      {
                        "pattern": "^licenses\\/.*"
                      }
                    ],
                    "format": "starts_with",
                    "maxLength": 240,
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "size": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  }
                },
                "required": [
                  "file",
                  "sha256",
                  "size"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "reservedFontNames": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "reviewedAt": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            "reviewedBy": {
              "minLength": 1,
              "type": "string"
            },
            "rfn": {
              "additionalProperties": false,
              "properties": {
                "basis": {
                  "minLength": 1,
                  "type": "string"
                },
                "permissionEvidenceUrl": {
                  "format": "uri",
                  "type": "string"
                },
                "permissionText": {
                  "minLength": 1,
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "not-applicable",
                    "unmodified-distribution",
                    "permission-granted",
                    "renamed"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status",
                "basis"
              ],
              "type": "object"
            },
            "spdx": {
              "enum": [
                "OFL-1.1",
                "Apache-2.0",
                "CC0-1.0"
              ],
              "type": "string"
            }
          },
          "required": [
            "spdx",
            "approvedForRedistribution",
            "reviewedAt",
            "reviewedBy",
            "evidenceUrl",
            "files",
            "reservedFontNames",
            "rfn"
          ],
          "type": "object"
        },
        "role": {
          "enum": [
            "fixed",
            "core-cjk"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "archiveFileName": {
              "maxLength": 200,
              "type": "string"
            },
            "files": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "fileName": {
                    "maxLength": 200,
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "size": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  }
                },
                "required": [
                  "fileName",
                  "sha256",
                  "size"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "archiveFileName",
            "files"
          ],
          "type": "object"
        },
        "sourceFamilyName": {
          "minLength": 1,
          "type": "string"
        },
        "variants": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cmapAliases": {
                "items": {
                  "maximum": 1114111,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "display": {
                "enum": [
                  "auto",
                  "block",
                  "swap",
                  "fallback",
                  "optional"
                ],
                "type": "string"
              },
              "features": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "file": {
                "allOf": [
                  {
                    "pattern": "^(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\\\)(?!\\/).+$"
                  },
                  {
                    "pattern": "^fonts\\/.*"
                  }
                ],
                "format": "starts_with",
                "maxLength": 240,
                "type": "string"
              },
              "font": {
                "additionalProperties": false,
                "properties": {
                  "coverageCount": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "familyName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "format": {
                    "enum": [
                      "TTF",
                      "OTF",
                      "WOFF",
                      "WOFF2"
                    ],
                    "type": "string"
                  },
                  "italicAngle": {
                    "type": "number"
                  },
                  "postscriptName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "subfamilyName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "variationAxes": {
                    "additionalProperties": {
                      "additionalProperties": false,
                      "properties": {
                        "default": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        },
                        "min": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "min",
                        "default",
                        "max"
                      ],
                      "type": "object"
                    },
                    "propertyNames": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "weight": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  "widthClass": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  }
                },
                "required": [
                  "familyName",
                  "subfamilyName",
                  "postscriptName",
                  "format",
                  "weight",
                  "widthClass",
                  "italicAngle",
                  "coverageCount",
                  "variationAxes"
                ],
                "type": "object"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "size": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "stretch": {
                "pattern": "^(?:\\d{1,3}(?:\\.\\d+)?%|\\d{1,3}(?:\\.\\d+)?% \\d{1,3}(?:\\.\\d+)?%)$",
                "type": "string"
              },
              "style": {
                "enum": [
                  "normal",
                  "italic",
                  "oblique"
                ],
                "type": "string"
              },
              "unicodeRange": {
                "items": {
                  "pattern": "^U\\+[0-9A-F?]{1,6}(?:-[0-9A-F]{1,6})?$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "variationSettings": {
                "additionalProperties": {
                  "type": "number"
                },
                "propertyNames": {
                  "type": "string"
                },
                "type": "object"
              },
              "weight": {
                "pattern": "^(?:100|200|300|400|500|600|700|800|900)(?: (?:100|200|300|400|500|600|700|800|900))?$",
                "type": "string"
              }
            },
            "required": [
              "file",
              "sha256",
              "size",
              "weight",
              "style",
              "display",
              "font"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "familyName",
        "sourceFamilyName",
        "role",
        "version",
        "cssVariable",
        "fallbacks",
        "buildTools",
        "source",
        "license",
        "css",
        "variants"
      ],
      "type": "object"
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "file": {
                "allOf": [
                  {
                    "pattern": "^(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\\\)(?!\\/).+$"
                  },
                  {
                    "pattern": "^source\\/fonts\\/.*"
                  }
                ],
                "format": "starts_with",
                "maxLength": 240,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "size": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              }
            },
            "required": [
              "file",
              "sha256",
              "size"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "kind": {
          "const": "source",
          "type": "string"
        },
        "licenses": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "file": {
                "allOf": [
                  {
                    "pattern": "^(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\\\)(?!\\/).+$"
                  },
                  {
                    "pattern": "^source\\/licenses\\/.*"
                  }
                ],
                "format": "starts_with",
                "maxLength": 240,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "size": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              }
            },
            "required": [
              "file",
              "sha256",
              "size"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "upstream": {
          "additionalProperties": false,
          "properties": {
            "project": {
              "minLength": 1,
              "type": "string"
            },
            "retrievedAt": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            "revision": {
              "minLength": 1,
              "type": "string"
            },
            "url": {
              "format": "uri",
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "project",
            "version",
            "url",
            "retrievedAt"
          ],
          "type": "object"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "version",
        "upstream",
        "files",
        "licenses"
      ],
      "type": "object"
    }
  ],
  "title": "SenrenBanka family and source manifest v1"
}
