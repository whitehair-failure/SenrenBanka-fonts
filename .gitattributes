* text=auto eol=lf

*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# License bytes are hashed by descriptors and must survive checkouts exactly.
licenses/** -text -whitespace
fixtures/licenses/** -text -whitespace

*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.tar binary
*.gz binary
